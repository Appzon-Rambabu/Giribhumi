    <script type="text/javascript" language="javascript">
        function DisableBackButton() {
            window.history.forward(1)
        }
        DisableBackButton();
        window.onload = DisableBackButton;
        window.onpageshow = function (evt) { if (evt.persisted) DisableBackButton() }
        window.onunload = function () { void (0) }

        $(document).keydown(function (event) {
            if (event.keyCode == 123) { // Prevent F12
                return false;
            } else if (event.ctrlKey && event.shiftKey && event.keyCode == 73) { // Prevent Ctrl+Shift+I
                return false;
            }
            else if (event.ctrlKey && event.shiftKey && event.keyCode == 74) { // Prevent Ctrl+Shift+J
                return false;
            }
        });

        $(document).on("contextmenu", function (e) {
            e.preventDefault();
        });
    </script>

    <script type="text/javascript">
        var curruserid = sessionStorage.getItem("USER_ID");
        var curruserrole = sessionStorage.getItem("ROLE");
        $(document).ready(function () {
            CheckUser();
            MenuSetup();

            $("#loginusername").html(sessionStorage.getItem("USER_NAME"));
            $("#loginuserbank").html(sessionStorage.getItem("BANKNAME"));
            $("#loginuserbranch").html(sessionStorage.getItem("BRANCH_NAME"));
        });

        function CheckUser() {
            if (!curruserid || !curruserrole) {
                sessionStorage.clear();
                swal("info", "Session Expired !!!", "info");
                location.href = '../Loans/Login.aspx';
                return;
            }
        }

        function MenuSetup() {
            if (curruserrole == "Admin") {
                $("#isdisplayloan").hide();
                $("#newbranch").show();
                $("#branchuser").show();
                $("#chnageupwd").show();
                $("#uprofile").show();
            }
            else {
                $("#isdisplayloan").show();
                $("#newbranch").hide();
                $("#branchuser").hide();
                $("#chnageupwd").hide();
                $("#uprofile").hide();
            }

            if (curruserrole == "Assistant Manager" || curruserrole == "Branch Manager") {

                $("#loaninfoapp").show();
                $("#loanrelentry").show();
                $("#loanrelapp").show();
                $("#loanrejlist").show();
            }
            else {

                $("#loaninfoapp").hide();
                $("#loanrelentry").hide();
                $("#loanrelapp").hide();
                $("#loanrejlist").hide();
            }
        }

        function GetLogout() {
            sessionStorage.clear();
            swal("info", "Logout Successfully !!!", "info");
            location.href = '../Loans/Login.aspx';
            return;
        }
    </script>

