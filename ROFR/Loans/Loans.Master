    <style type="text/css">
        @media (min-width: 1200px) {
            .page-header-content {
                padding-left: 1rem;
                padding-right: 1rem;
            }
        }

        .card {
            box-shadow: 0 3px 15px 0 #E0E0E0;
            border-radius: 11px;
        }

        .card-header .card-title {
            font-weight: 800;
            font-family: "Roboto";
            font-size: 16px;
        }

        .card-body fieldset {
        }

        .card-body .bg-primary-800 {
            background-color: #174d8b;
        }

        .card-body legend {
            margin-bottom: 0.50rem;
            font-family: "Roboto", Arial, sans-serif !important;
            font-weight: 600;
            font-size: 13px;
            padding: 5px 10px !important;
        }

        .card-body .form-group {
            margin: 0.5rem 0.5rem;
        }

            .card-body .form-group .required {
                color: red;
            }

            .card-body .form-group .form-control, .card-body .form-group button {
                padding: 0.2rem 1rem !important;
                height: 28.4px;
            }

            .card-body .form-group select.form-control:not([size]):not([multiple]) {
                height: 28.4px;
            }

            .card-body .form-group .btn-primary {
                background-color: #174d8b;
            }

        .font-telugu h2 {
            font-size: 30px;
            font-family: 'Ramabhadra', sans-serif;
            text-shadow: 2px 2px rgba(0,0,0,0.3);
            line-height: 1.2;
        }

        .custom-bg {
            background: url(../Loans/assets/images/header-bg.jpg);
            background-repeat: no-repeat;
            background-position: center right;
            background-size: cover;
        }

        /*Loader*/
        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../Loans/assets/images/loader.gif') 50% 50% no-repeat #ffffffb8 !important;
        }

        .table th, .table td {
            padding: 0.25rem 0.25rem !important;
        }

        legend {
            background: #004085;
            padding: 4px 22px;
            border-radius: 3px;
            color: white;
            font-size: 16px;
        }

        fieldset {
            border: 2px solid gray !important;
            border-radius: 3px;
            padding: 10px !important;
        }

        .w-72 {
            width: 72% !important;
        }

        .card {
            box-shadow: 0px 5px 10px rgba(0,0,0,0.3);
        }

        .table-wrap {
            max-height: 150px;
            overflow: auto;
        }

        /*.dropdown:hover > .dropdown-menu {
            display: block;
        }*/

        .dropdown-menu-right {
            left: 0 !important;
            right: auto !important;
        }

        .card-header .card-title {
            margin-bottom: 0;
            font-weight: 500;
            font-size: 16px !important;
        }

        .form-control {
            background-color: #efefef !important;
            font-weight: bold;
        }

            .form-control:disabled {
                color: #000 !important;
            }

        .card-body {
            padding: 0.50rem !important;
        }

            .card-body .form-group {
                margin: 0.25rem 0.25rem !important;
            }
    </style>

