    <script>
        (function () {
            const second = 1000,
                minute = second * 60,
                hour = minute * 60;

            let countDown = new Date().getTime() + (59 * minute + 59 * second);

            const x = setInterval(function () {
                const now = new Date().getTime(),
                    distance = countDown - now;

                const minutes = Math.floor((distance % hour) / minute);
                const seconds = Math.floor((distance % minute) / second);

                const minuteElem = document.getElementById("minutes");
                const secondElem = document.getElementById("seconds");
                const minLabelElem = document.getElementById("minLabel");
                const secLabelElem = document.getElementById("secLabel");

                if (minuteElem && secondElem) {
                    minuteElem.innerText = minutes < 10 ? '0' + minutes : minutes;
                    secondElem.innerText = seconds < 10 ? '0' + seconds : seconds;
                }

                if (distance <= 5 * minute) {
                    if (minuteElem) minuteElem.classList.add("blink");
                    if (secondElem) secondElem.classList.add("blink");
                    if (minLabelElem) minLabelElem.classList.add("blink");
                    if (secLabelElem) secLabelElem.classList.add("blink");
                }

                if (distance < 0) {
                    clearInterval(x);

                    const headline = document.getElementById("headline");
                    const countdownDiv = document.getElementById("countdown");
                    const contentDiv = document.getElementById("content");

                    if (headline) headline.innerText = "Countdown Finished!";
                    if (countdownDiv) countdownDiv.style.display = "none";
                    if (contentDiv) contentDiv.style.display = "block";

                    alert("Session is Expired! Please Login");

                    setTimeout(function () {
                        window.location.href = "Login.aspx";
                    }, 100);
                }
            }, second);
        })();


    </script>
