    <style>
        /* Blinking effect using CSS animation */
        .blink {
            animation: blink-animation 1s steps(1, start) infinite;
            color: red; /* Change text color to red when blinking */
        }

        /* Keyframes for the blink animation */
        @keyframes blink-animation {
            50% {
                visibility: hidden;
            }
        }
        /* Red color style */
        .red {
            color: red;
        }

        .redcolor {
            color: green;
        }
    </style>
