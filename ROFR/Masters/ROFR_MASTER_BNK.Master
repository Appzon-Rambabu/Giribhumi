       .nav-item.dropdown:hover .dropdown-menu{
	display:block;
}
.nav-item.dropdown:hover .dropdown-menu .dropdown-submenu .dropdown-menu{
	display:none;
}
.dropdown-menu .dropdown-submenu:hover .dropdown-menu{
	display:block !important;
}
       
