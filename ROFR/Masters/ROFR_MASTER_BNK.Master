   <script>
        function disableBackButton() {
            window.history.forward()
        }
        disableBackButton(); dis();
        window.onload = disableBackButton();
        window.onpageshow = function (evt) {if (evt.persisted) disableBackButton() }
        window.onunload = function () { void (0) }
       // windowwindow.onload = window.history.forward(0);
        function dis() {
            window.history.pushState(null, "", window.location.href);
            window.onpopstate = function () {
                window.history.pushState(null, "", window.location.href);
                //alert('hello');
            };

            //window.addEventListener('popstate', () => {
            //    history.pushState(null, null, null);
            //    alert("If you go back to the previous page, please back from the return to the previous button.");
            //});
            
                      // window.addEventListener('popstate', function () { alert(1); });
        }
