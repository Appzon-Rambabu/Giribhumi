    <script src="../Rofrnewassets/js/scripts.js"></script>
    <script src="../Rofrnewassets/js/jquery.easy-ticker.js"></script>
    <%--<link href="https://fonts.googleapis.com/css?family=Ramabhadra" rel="stylesheet"/>--%>
    <link href="../newcss/css/font.css" rel="stylesheet" />
    
   

    <script>
        (function () {
            const second = 1000,       // 1000 milliseconds = 1 second
                minute = second * 60,
                hour = minute * 60;

            // Set the initial countdown duration to 59 minutes and 59 seconds
            let countDown = new Date().getTime() + (59 * minute + 59 * second);

            const x = setInterval(function () {
                const now = new Date().getTime(),
                    distance = countDown - now;

                // Calculate minutes and seconds
                const minutes = Math.floor((distance % hour) / minute);
                const seconds = Math.floor((distance % minute) / second);

                const minuteElem = document.getElementById("minutes");
                const secondElem = document.getElementById("seconds");
                const minLabelElem = document.getElementById("minLabel");
                const secLabelElem = document.getElementById("secLabel");

                // Display the countdown in the HTML elements
                document.getElementById("minutes").innerText = minutes < 10 ? '0' + minutes : minutes;
                document.getElementById("seconds").innerText = seconds < 10 ? '0' + seconds : seconds;

                if (distance <= 5 * minute) {
                    minuteElem.classList.add("blink");
                    secondElem.classList.add("blink");
                    minLabelElem.classList.add("blink");  // Blink "Min" label
                    secLabelElem.classList.add("blink");  // Blink "Sec" label
                }

                // When the countdown reaches 0, stop the interval and update the display
                if (distance < 0) {
                    clearInterval(x);
                    document.getElementById("headline").innerText = "Countdown Finished!";
                    document.getElementById("countdown").style.display = "none";
                    document.getElementById("content").style.display = "block";

                    alert("Session is Expaired! Please Login");
                    window.location.href = "Login.aspx"
                }
            }, second);
        })();
    </script> 
